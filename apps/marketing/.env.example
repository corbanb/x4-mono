# Marketing Site Environment Variables
# Copy to .env.local and fill in values

# URL of the web app (for CTA links like "Get Started", "Sign In")
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog web analytics (optional — omit the key to disable analytics entirely)
# Project API key from PostHog → Settings → Project
NEXT_PUBLIC_POSTHOG_KEY=
# Use https://eu.i.posthog.com if the PostHog project lives on EU Cloud
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
